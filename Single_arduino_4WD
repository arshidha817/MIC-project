#include <AFMotor.h>
#include "HX711.h"

// Motor Setup
AF_DCMotor m1(1); // Right Rear
AF_DCMotor m2(2); // Right Front
AF_DCMotor m3(3); // Left Front
AF_DCMotor m4(4); // Left Back

// Pin Definitions
const int HX711_DT = A4;
const int HX711_SCK = A2;
const int IR_LEFT = A3;
const int IR_RIGHT = A0;
const int TRIG = A5;
const int ECHO = A1;
const int BUZZER = 2;

// Thresholds & Settings
int robotSpeed = 230;
float weightThreshold = 10.0; 
int obstacleDistance = 5; // Distance in cm
HX711 scale;

void setup() {
  Serial.begin(9600);
  
  m1.setSpeed(robotSpeed);
  m2.setSpeed(robotSpeed);
  m3.setSpeed(robotSpeed);
  m4.setSpeed(robotSpeed);
  stopRobot();

  pinMode(IR_LEFT, INPUT);
  pinMode(IR_RIGHT, INPUT);
  pinMode(BUZZER, OUTPUT);
  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);
  
  scale.begin(HX711_DT, HX711_SCK);
  scale.set_scale(); 
  scale.tare();      
}

void loop() {
  // 1. INITIAL STATE: Wait for weight
  while (getWeight() < weightThreshold) {
    stopRobot();
    digitalWrite(BUZZER, LOW);
    delay(100); 
  }

  // 2. MOVEMENT STATE: Line Following + Obstacle Check
  bool atTable = false;
  while (!atTable) {
    checkObstacle(); // New: Pauses everything if obstacle < 5cm

    int leftVal = digitalRead(IR_LEFT);
    int rightVal = digitalRead(IR_RIGHT);

    if (leftVal == LOW && rightVal == LOW) {
      atTable = true;
    } else {
      moveForward();
    }
  }

  // 3. TABLE STATE: Stop and Buzz until weight removed
  stopRobot();
  while (getWeight() >= weightThreshold) {
    digitalWrite(BUZZER, HIGH); 
    delay(200);
    digitalWrite(BUZZER, LOW);
    delay(200);
  }
  
  // 4. EXIT STATE: Move forward for 3 seconds + Obstacle Check
  unsigned long startTime = millis();
  while (millis() - startTime < 3000) {
    checkObstacle(); // Still check for obstacles during the 3s exit
    moveForward();
  }
  
  stopRobot();
}

// --- New Obstacle Detection Logic ---

void checkObstacle() {
  long distance = getDistance();
  
  // If obstacle detected within 5cm
  while (distance > 0 && distance <= obstacleDistance) {
    stopRobot();
    digitalWrite(BUZZER, HIGH); // Constant beep or rapid beep
    delay(100);
    digitalWrite(BUZZER, LOW);
    delay(100);
    distance = getDistance(); // Re-check if obstacle is still there
  }
}

long getDistance() {
  digitalWrite(TRIG, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG, LOW);
  
  long duration = pulseIn(ECHO, HIGH);
  long cm = duration * 0.034 / 2;
  
  return (cm == 0) ? 999 : cm; // Return a high number if sensor times out
}

// --- Movement Functions ---

void moveForward() {
  m1.run(FORWARD); m2.run(FORWARD);
  m3.run(FORWARD); m4.run(FORWARD);
}

void stopRobot() {
  m1.run(RELEASE); m2.run(RELEASE);
  m3.run(RELEASE); m4.run(RELEASE);
}

float getWeight() {
  return scale.get_units(5); 
}
